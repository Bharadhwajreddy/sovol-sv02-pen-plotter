; Sovol SV02 Pen Plotter — Square Maze
; Canvas: 200x160mm  Offset: X40 Y40
; Canvas center: X140 Y120
;
G21 ; mm units
G90 ; absolute positioning
G28 X Y ; home X and Y ONLY — never home Z
G0 Z3.000 F3000 ; pen up

; Outer border (5x5 grid of 20mm cells, origin at mx=90, my=70)
G0 X90.000 Y70.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X190.000 Y70.000 F1500
G1 X190.000 Y170.000 F1500
G1 X90.000 Y170.000 F1500
G1 X90.000 Y70.000 F1500
G0 Z3.000 F3000 ; pen up

; Internal H walls — H[col,row]: from (90+col*20, 70+row*20) to (90+col*20+20, 70+row*20)
; H(0,1)
G0 X90.000 Y90.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X110.000 Y90.000 F1500
G0 Z3.000 F3000 ; pen up
; H(1,1)
G0 X110.000 Y90.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X130.000 Y90.000 F1500
G0 Z3.000 F3000 ; pen up
; H(3,1)
G0 X150.000 Y90.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X170.000 Y90.000 F1500
G0 Z3.000 F3000 ; pen up
; H(4,1)
G0 X170.000 Y90.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X190.000 Y90.000 F1500
G0 Z3.000 F3000 ; pen up
