; Sovol SV02 Pen Plotter — Tom Cat Face
; Canvas: 200x160mm  Offset: X40 Y40
; Canvas center: X140 Y120
;
G21 ; mm units
G90 ; absolute positioning
G28 X Y ; home X and Y ONLY — never home Z
G0 Z3.000 F3000 ; pen up

; Head oval (4 CW arcs)
G0 X140.000 Y162.000 F3000
G0 Z0.000 F3000 ; pen down
G2 X175.000 Y120.000 I0.000 J-42.000 F1500
G2 X140.000 Y82.000 I-35.000 J0.000 F1500
G2 X105.000 Y120.000 I0.000 J38.000 F1500
G2 X140.000 Y162.000 I35.000 J0.000 F1500
G0 Z3.000 F3000 ; pen up

; Left ear
G0 X110.000 Y148.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X92.000 Y178.000 F1500
G1 X128.000 Y166.000 F1500
G1 X110.000 Y148.000 F1500
G0 Z3.000 F3000 ; pen up

; Right ear
G0 X170.000 Y148.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X188.000 Y178.000 F1500
G1 X152.000 Y166.000 F1500
G1 X170.000 Y148.000 F1500
G0 Z3.000 F3000 ; pen up

; Left eye r=8 at (126,130)
G0 X134.000 Y130.000 F3000
G0 Z0.000 F3000 ; pen down
G2 X134.000 Y130.000 I-8.000 J0.000 F1500 ; full circle
G0 Z3.000 F3000 ; pen up

; Right eye r=8 at (154,130)
G0 X162.000 Y130.000 F3000
G0 Z0.000 F3000 ; pen down
G2 X162.000 Y130.000 I-8.000 J0.000 F1500 ; full circle
G0 Z3.000 F3000 ; pen up

; Left pupil r=3 at (126,130)
G0 X129.000 Y130.000 F3000
G0 Z0.000 F3000 ; pen down
G2 X129.000 Y130.000 I-3.000 J0.000 F1500 ; full circle
G0 Z3.000 F3000 ; pen up

; Right pupil r=3 at (154,130)
G0 X157.000 Y130.000 F3000
G0 Z0.000 F3000 ; pen down
G2 X157.000 Y130.000 I-3.000 J0.000 F1500 ; full circle
G0 Z3.000 F3000 ; pen up

; Nose triangle
G0 X135.000 Y115.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X145.000 Y115.000 F1500
G1 X140.000 Y107.000 F1500
G1 X135.000 Y115.000 F1500
G0 Z3.000 F3000 ; pen up

; Mouth W
G0 X122.000 Y102.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X132.000 Y108.000 F1500
G1 X140.000 Y102.000 F1500
G1 X148.000 Y108.000 F1500
G1 X158.000 Y102.000 F1500
G0 Z3.000 F3000 ; pen up

; Whiskers left — top
G0 X102.000 Y116.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X130.000 Y118.000 F1500
G0 Z3.000 F3000 ; pen up
; Whiskers left — middle
G0 X102.000 Y109.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X130.000 Y112.000 F1500
G0 Z3.000 F3000 ; pen up
; Whiskers left — bottom
G0 X102.000 Y102.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X130.000 Y106.000 F1500
G0 Z3.000 F3000 ; pen up

; Whiskers right — top
G0 X150.000 Y118.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X178.000 Y116.000 F1500
G0 Z3.000 F3000 ; pen up
; Whiskers right — middle
G0 X150.000 Y112.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X178.000 Y109.000 F1500
G0 Z3.000 F3000 ; pen up
; Whiskers right — bottom
