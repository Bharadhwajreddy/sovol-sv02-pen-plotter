; Sovol SV02 Pen Plotter — Calibration Cross
; Canvas: 200x160mm  Offset: X40 Y40
; Canvas center: X140 Y120
;
G21 ; mm units
G90 ; absolute positioning
G28 X Y ; home X and Y ONLY — never home Z
G0 Z3.000 F3000 ; pen up

; Horizontal line
G0 X40.000 Y120.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X240.000 Y120.000 F1500
G0 Z3.000 F3000 ; pen up

; Vertical line
G0 X140.000 Y40.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X140.000 Y200.000 F1500
G0 Z3.000 F3000 ; pen up

; Corner mark at (40,40)
G0 X36.000 Y40.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X44.000 Y40.000 F1500
G0 Z3.000 F3000 ; pen up
G0 X40.000 Y36.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X40.000 Y44.000 F1500
G0 Z3.000 F3000 ; pen up

; Corner mark at (240,40)
G0 X236.000 Y40.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X244.000 Y40.000 F1500
G0 Z3.000 F3000 ; pen up
G0 X240.000 Y36.000 F3000
G0 Z0.000 F3000 ; pen down
G1 X240.000 Y44.000 F1500
G0 Z3.000 F3000 ; pen up

; Corner mark at (40,200)
